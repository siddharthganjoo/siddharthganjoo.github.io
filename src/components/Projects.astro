---
import { projectsData } from '../data/projects';
import { siteConfig } from '../data/site';
---

<section id="projects" class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Projects</span>
      <h2 class="headline">Selected work.</h2>
      <p class="subhead">Research and commercial machine learning systems with measurable impact.</p>
    </div>

    <div class="projects-grid">
      {projectsData.map(project => (
        <article class:list={['project card reveal', { featured: project.isFeatured }]}>
          <div class="project-media">
            <img src={project.image} alt="" loading="lazy" />
          </div>
          <div class="project-body">
            <p class="project-tag">{project.tag}</p>
            <h3 class="project-title">{project.title}</h3>
            <p class="project-desc">{project.description}</p>
            <ul class="project-impact" aria-label="Impact">
              {project.impact.map(item => <li class="chip">{item}</li>)}
            </ul>
            {project.links && project.links.length > 0 && (
              <div class="project-links">
                {project.links.map(link => (
                  <a href={link.url} class="link-chevron" target="_blank" rel="noopener noreferrer">{link.label}</a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="projects-more reveal">
      <a href={`${siteConfig.socials.github}?tab=repositories`} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
        <i class="fab fa-github" aria-hidden="true"></i> More on GitHub
      </a>
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .project {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .project.featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
  }

  .project-media {
    aspect-ratio: 16 / 9;
    background: var(--card-fill);
    overflow: hidden;
  }

  .project.featured .project-media {
    aspect-ratio: auto;
    min-height: 320px;
  }

  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .project:hover .project-media img {
    transform: scale(1.03);
  }

  .project-body {
    padding: 32px 36px 36px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project.featured .project-body {
    justify-content: center;
    padding: 48px;
  }

  .project-tag {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-tertiary);
    margin-bottom: 6px;
  }

  .project-title {
    font-size: clamp(24px, 2.4vw, 28px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .project.featured .project-title {
    font-size: clamp(28px, 3.4vw, 40px);
  }

  .project-desc {
    margin-top: 10px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .project-impact {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .project-links {
    display: flex;
    gap: 24px;
    margin-top: 24px;
  }

  .projects-more {
    margin-top: 48px;
    text-align: center;
  }

  @media (max-width: 834px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .project.featured {
      grid-template-columns: 1fr;
    }

    .project.featured .project-media {
      aspect-ratio: 16 / 9;
      min-height: 0;
    }

    .project-body,
    .project.featured .project-body {
      padding: 24px;
    }
  }
</style>
