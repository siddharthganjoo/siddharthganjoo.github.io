---
import { recommendationsData } from '../data/recommendations';
---

<section id="recommendations" class="section">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">Recommendations</span>
      <h2 class="headline">In their words.</h2>
    </div>

    <div class="quotes">
      {recommendationsData.map(rec => (
        <figure class="quote card reveal">
          <blockquote class="quote-text">“{rec.quote}”</blockquote>
          <figcaption class="quote-by">
            <img src={rec.photo} alt="" width="44" height="44" loading="lazy" />
            <span>
              <span class="quote-name">{rec.name}</span>
              <span class="quote-role">{rec.title}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .quote {
    padding: 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }

  .quote-text {
    font-size: clamp(21px, 2.2vw, 26px);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--text);
  }

  .quote-by {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .quote-by img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
  }

  .quote-name,
  .quote-role {
    display: block;
    line-height: 1.3;
  }

  .quote-name {
    font-size: 15px;
    font-weight: 600;
  }

  .quote-role {
    font-size: 14px;
    color: var(--text-tertiary);
  }

  @media (max-width: 834px) {
    .quotes {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .quote {
      padding: 28px 24px;
    }
  }
</style>
