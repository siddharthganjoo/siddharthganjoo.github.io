---

<div class="cmd-overlay" id="cmd-overlay" role="dialog" aria-modal="true" aria-label="Command Palette">
  <div class="cmd-palette">
    <div class="cmd-search-wrap">
      <i class="fas fa-search cmd-search-icon"></i>
      <input type="text" id="cmd-input" class="cmd-input" placeholder="Type a command or search..." autocomplete="off" />
      <span class="cmd-esc-badge">ESC</span>
    </div>

    <div class="cmd-results" id="cmd-results">
      <div class="cmd-group-title">Navigation</div>
      <a href="#about" class="cmd-item" data-action="navigate">
        <i class="fas fa-user-circle"></i>
        <span>About Me</span>
        <span class="cmd-shortcut">Jump</span>
      </a>
      <a href="#timeline" class="cmd-item" data-action="navigate">
        <i class="fas fa-clock-rotate-left"></i>
        <span>Timeline (Experience &amp; News)</span>
        <span class="cmd-shortcut">Jump</span>
      </a>
      <a href="#projects" class="cmd-item" data-action="navigate">
        <i class="fas fa-layer-group"></i>
        <span>Selected Projects</span>
        <span class="cmd-shortcut">Jump</span>
      </a>
      <a href="#github" class="cmd-item" data-action="navigate">
        <i class="fab fa-github"></i>
        <span>GitHub Activity &amp; Open Source</span>
        <span class="cmd-shortcut">Jump</span>
      </a>
      <a href="#research" class="cmd-item" data-action="navigate">
        <i class="fas fa-feather-pointed"></i>
        <span>Technical Articles &amp; Research</span>
        <span class="cmd-shortcut">Jump</span>
      </a>
      <a href="#recommendations" class="cmd-item" data-action="navigate">
        <i class="fas fa-quote-left"></i>
        <span>Recommendations</span>
        <span class="cmd-shortcut">Jump</span>
      </a>
      <a href="#contact" class="cmd-item" data-action="navigate">
        <i class="fas fa-envelope"></i>
        <span>Contact &amp; Get in touch</span>
        <span class="cmd-shortcut">Jump</span>
      </a>

      <div class="cmd-group-title">Quick Actions</div>
      <a href="#contact" class="cmd-item" data-action="navigate">
        <i class="fas fa-paper-plane"></i>
        <span>Send a Message (Contact Form)</span>
        <span class="cmd-shortcut">Form</span>
      </a>
      <button type="button" class="cmd-item" data-action="toggle-theme">
        <i class="fas fa-circle-half-stroke"></i>
        <span>Toggle Dark / Light Theme</span>
        <span class="cmd-shortcut">Theme</span>
      </button>
      <a href="assets/CV_SiddharthGanjoo.pdf" target="_blank" class="cmd-item" data-action="resume">
        <i class="fas fa-file-pdf"></i>
        <span>Download Resume (PDF)</span>
        <span class="cmd-shortcut">PDF</span>
      </a>
      <a href="https://github.com/siddharthganjoo" target="_blank" rel="noopener noreferrer" class="cmd-item" data-action="external">
        <i class="fab fa-github"></i>
        <span>GitHub Profile</span>
        <span class="cmd-shortcut">Link</span>
      </a>
      <a href="https://linkedin.com/in/siddharthganjoo" target="_blank" rel="noopener noreferrer" class="cmd-item" data-action="external">
        <i class="fab fa-linkedin"></i>
        <span>LinkedIn Profile</span>
        <span class="cmd-shortcut">Link</span>
      </a>
    </div>

    <div class="cmd-footer">
      <span><kbd>↑</kbd> <kbd>↓</kbd> to navigate</span>
      <span><kbd>↵</kbd> to select</span>
      <span><kbd>esc</kbd> to close</span>
    </div>
  </div>
</div>

<style>
  .cmd-overlay {
    position: fixed;
    inset: 0;
    z-index: 2500;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 10vh 1rem 2rem;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .cmd-overlay:global(.active) {
    display: flex;
    opacity: 1;
  }

  .cmd-palette {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 16px;
    width: 100%;
    max-width: 580px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    overflow: hidden;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    animation: cmdSlideDown 0.2s ease;
  }

  @keyframes cmdSlideDown {
    from { transform: translateY(-16px) scale(0.98); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }

  .cmd-search-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .cmd-search-icon {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .cmd-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-size: 0.95rem;
    font-family: inherit;
  }

  .cmd-input::placeholder {
    color: var(--text-muted);
  }

  .cmd-esc-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .cmd-results {
    max-height: 380px;
    overflow-y: auto;
    padding: 0.5rem;
  }

  .cmd-group-title {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding: 0.5rem 0.75rem 0.25rem;
  }

  .cmd-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    border-radius: 8px;
    color: var(--text);
    font-size: 0.875rem;
    cursor: pointer;
    background: transparent;
    border: none;
    width: 100%;
    text-align: left;
    transition: background 0.15s ease, color 0.15s ease;
    text-decoration: none;
  }

  .cmd-item i {
    width: 16px;
    text-align: center;
    color: var(--accent);
    font-size: 0.9rem;
  }

  .cmd-item span:first-of-type {
    flex: 1;
  }

  .cmd-shortcut {
    font-size: 0.7rem;
    color: var(--text-muted);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }

  .cmd-item:hover,
  .cmd-item:global(.selected) {
    background: var(--accent-light);
    color: var(--accent);
  }

  .cmd-item:global(.hidden) {
    display: none;
  }

  .cmd-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.25rem;
    background: var(--bg);
    border-top: 1px solid var(--border);
    font-size: 0.725rem;
    color: var(--text-muted);
  }

  .cmd-footer kbd {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.1rem 0.35rem;
    font-family: inherit;
    font-size: 0.675rem;
  }
</style>

<script>
  const overlay = document.getElementById('cmd-overlay');
  const input = document.getElementById('cmd-input') as HTMLInputElement | null;
  const items = document.querySelectorAll('.cmd-item');

  function openPalette() {
    if (!overlay || !input) return;
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
    input.value = '';
    filterItems('');
    setTimeout(() => input.focus(), 50);
  }

  function closePalette() {
    if (!overlay) return;
    overlay.classList.remove('active');
    document.body.style.overflow = '';
  }

  function filterItems(query: string) {
    const q = query.toLowerCase().trim();
    items.forEach(item => {
      const text = item.textContent?.toLowerCase() || '';
      if (!q || text.includes(q)) {
        item.classList.remove('hidden');
      } else {
        item.classList.add('hidden');
      }
    });
  }

  // Keyboard shortcut Cmd+K / Ctrl+K
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (overlay?.classList.contains('active')) {
        closePalette();
      } else {
        openPalette();
      }
    } else if (e.key === 'Escape' && overlay?.classList.contains('active')) {
      closePalette();
    }
  });

  // Open trigger button from navbar
  document.querySelectorAll('[data-trigger-cmd]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      openPalette();
    });
  });

  // Filter on input
  input?.addEventListener('input', () => {
    filterItems(input.value);
  });

  // Close when clicking backdrop
  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) closePalette();
  });

  // Action clicks
  items.forEach(item => {
    item.addEventListener('click', (e) => {
      const action = item.getAttribute('data-action');
      if (action === 'toggle-theme') {
        e.preventDefault();
        const current = document.documentElement.getAttribute('data-theme') || 'light';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        closePalette();
      } else if (action === 'navigate') {
        closePalette();
      }
    });
  });
</script>

