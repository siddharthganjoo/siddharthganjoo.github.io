---
import { siteConfig } from '../data/site';

const isHome = Astro.url.pathname === '/' || Astro.url.pathname.endsWith('/index.html');
const prefix = isHome ? '' : '/';

const sections = [
  { href: '#about', icon: 'fa-user', label: 'About' },
  { href: '#skills', icon: 'fa-toolbox', label: 'Toolkit' },
  { href: '#experience', icon: 'fa-briefcase', label: 'Experience' },
  { href: '#organisations', icon: 'fa-building', label: 'Who I work with' },
  { href: '#highlights', icon: 'fa-award', label: 'Highlights' },
  { href: '#projects', icon: 'fa-layer-group', label: 'Projects' },
  { href: '#writing', icon: 'fa-feather-pointed', label: 'Writing' },
  { href: '#recommendations', icon: 'fa-quote-left', label: 'Recommendations' },
  { href: '#contact', icon: 'fa-envelope', label: 'Contact' }
];
---

<dialog class="cmd" id="cmd" aria-label="Search">
  <div class="cmd-search">
    <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
    <input type="text" id="cmd-input" placeholder="Search sections and links" autocomplete="off" aria-controls="cmd-results" />
    <kbd>esc</kbd>
  </div>

  <div class="cmd-results" id="cmd-results">
    <p class="cmd-group">Go to</p>
    {sections.map(s => (
      <a href={prefix + s.href} class="cmd-item">
        <i class={`fas ${s.icon}`} aria-hidden="true"></i><span>{s.label}</span>
      </a>
    ))}

    <p class="cmd-group">Actions</p>
    <button type="button" class="cmd-item" data-action="toggle-theme">
      <i class="fas fa-circle-half-stroke" aria-hidden="true"></i><span>Toggle dark mode</span>
    </button>
    <a href={siteConfig.resumeUrl} target="_blank" rel="noopener noreferrer" class="cmd-item">
      <i class="fas fa-file-lines" aria-hidden="true"></i><span>Open resume (PDF)</span>
    </a>
    <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer" class="cmd-item">
      <i class="fab fa-linkedin" aria-hidden="true"></i><span>LinkedIn</span>
    </a>
    <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer" class="cmd-item">
      <i class="fab fa-github" aria-hidden="true"></i><span>GitHub</span>
    </a>
    <p class="cmd-empty" id="cmd-empty" hidden>No results</p>
  </div>

  <div class="cmd-footer" aria-hidden="true">
    <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
    <span><kbd>↵</kbd> open</span>
    <span><kbd>⌘K</kbd> toggle</span>
  </div>
</dialog>

<style>
  .cmd {
    margin: 12vh auto auto;
    width: min(560px, calc(100vw - 32px));
    max-height: 70vh;
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    color: var(--text);
    box-shadow: var(--shadow-md), 0 0 0 1px var(--hairline);
    overflow: hidden;
  }

  .cmd[open] {
    display: flex;
    flex-direction: column;
    animation: cmd-in 0.25s var(--ease);
  }

  @keyframes cmd-in {
    from { opacity: 0; transform: translateY(-8px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }

  .cmd::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .cmd-search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--hairline);
    color: var(--text-tertiary);
  }

  .cmd-search input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 17px;
  }

  .cmd-search input::placeholder {
    color: var(--text-tertiary);
  }

  kbd {
    font-family: inherit;
    font-size: 12px;
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--fill);
    color: var(--text-secondary);
  }

  .cmd-results {
    overflow-y: auto;
    padding: 8px;
  }

  .cmd-group {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-tertiary);
    padding: 12px 12px 6px;
  }

  .cmd-item {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 44px;
    padding: 0 12px;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: var(--text);
    font-size: 15px;
    text-align: left;
    cursor: pointer;
  }

  .cmd-item i {
    width: 18px;
    text-align: center;
    color: var(--text-tertiary);
  }

  .cmd-item:hover {
    text-decoration: none;
  }

  .cmd-results [hidden] {
    display: none;
  }

  .cmd-item:global(.selected) {
    background: var(--accent-fill);
    color: #ffffff;
  }

  .cmd-item:global(.selected) i {
    color: #ffffff;
  }

  .cmd-empty {
    padding: 24px 12px;
    text-align: center;
    color: var(--text-tertiary);
    font-size: 15px;
  }

  .cmd-footer {
    display: flex;
    gap: 16px;
    padding: 10px 20px;
    border-top: 1px solid var(--hairline);
    font-size: 12px;
    color: var(--text-tertiary);
  }

  .cmd-footer kbd {
    margin-right: 2px;
  }

  @media (max-width: 734px) {
    .cmd-footer {
      display: none;
    }
  }
</style>

<script>
  const dialog = document.getElementById('cmd') as HTMLDialogElement | null;
  const input = document.getElementById('cmd-input') as HTMLInputElement | null;
  const empty = document.getElementById('cmd-empty');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.cmd-item'));
  let visible: HTMLElement[] = items;
  let index = 0;

  function select(i: number) {
    items.forEach(el => el.classList.remove('selected'));
    if (!visible.length) return;
    index = (i + visible.length) % visible.length;
    visible[index].classList.add('selected');
    visible[index].scrollIntoView({ block: 'nearest' });
  }

  function filter(query: string) {
    const q = query.trim().toLowerCase();
    visible = [];
    items.forEach(el => {
      const match = !q || (el.textContent || '').toLowerCase().includes(q);
      el.hidden = !match;
      if (match) visible.push(el);
    });
    document.querySelectorAll<HTMLElement>('.cmd-group').forEach(g => (g.hidden = !!q));
    if (empty) empty.hidden = visible.length > 0;
    select(0);
  }

  function open() {
    if (!dialog || !input) return;
    input.value = '';
    filter('');
    dialog.showModal();
    input.focus();
  }

  document.querySelectorAll('[data-trigger-cmd]').forEach(btn => btn.addEventListener('click', open));

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog?.open ? dialog.close() : open();
    }
  });

  input?.addEventListener('input', () => filter(input.value));
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); select(index + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); select(index - 1); }
    else if (e.key === 'Enter') { e.preventDefault(); visible[index]?.click(); }
  });

  items.forEach(el => {
    el.addEventListener('mousemove', () => {
      const i = visible.indexOf(el);
      if (i !== index) select(i);
    });
    el.addEventListener('click', () => {
      if (el.dataset.action === 'toggle-theme') {
        document.getElementById('theme-toggle')?.click();
      }
      dialog?.close();
    });
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
