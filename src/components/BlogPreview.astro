---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<section id="writing" class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Writing</span>
      <h2 class="headline">Notes from the work.</h2>
      <p class="subhead">Deep dives into supercomputing and industrial machine learning.</p>
    </div>

    <div class="articles">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} class="article card reveal">
          <p class="article-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}
            </time>
            <span aria-hidden="true">·</span>
            <span>{post.data.readTime}</span>
          </p>
          <h3 class="article-title">{post.data.title}</h3>
          <p class="article-desc">{post.data.description}</p>
          <span class="link-chevron article-cta">Read article</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .articles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .article {
    display: flex;
    flex-direction: column;
    padding: 36px;
    color: var(--text);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }

  .article:hover {
    text-decoration: none;
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .article-meta {
    display: flex;
    gap: 8px;
    font-size: 14px;
    color: var(--text-tertiary);
    margin-bottom: 12px;
  }

  .article-title {
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .article-desc {
    margin-top: 12px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--text-secondary);
    flex-grow: 1;
  }

  .article-cta {
    margin-top: 24px;
  }

  @media (prefers-reduced-motion: reduce) {
    .article:hover {
      transform: none;
    }
  }

  @media (max-width: 834px) {
    .articles {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .article {
      padding: 28px 24px;
    }
  }
</style>
