---
import { siteConfig } from '../data/site';
---

<section id="top" class="hero">
  <div class="hero-inner">
    <img
      src="/assets/pp.JPG"
      alt={`Portrait of ${siteConfig.name}`}
      class="hero-photo"
      width="112"
      height="112"
      fetchpriority="high"
    />
    <p class="hero-eyebrow">Machine Learning Engineer · Supercomputing Brabant</p>
    <h1 class="hero-title">AI, at<br class="br-sm" /> supercomputer scale.</h1>
    <p class="hero-lede">
      I optimise GPU workloads and AI infrastructure on the SPIKE cluster (NVIDIA DGX B300), helping
      companies in Brabant deploy AI at scale. Before that, I put reinforcement learning and computer
      vision into production at Vencomatic Group and LoopIt.ai.
    </p>
    <div class="hero-actions">
      <a href="#contact" class="btn btn-primary">Get in touch</a>
      <a href="#projects" class="link-chevron">See my work</a>
    </div>
  </div>

  <dl class="hero-stats">
    {siteConfig.stats.map(stat => (
      <div class="stat">
        <dt class="stat-label">{stat.label}</dt>
        <dd class="stat-value">{stat.value}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .hero {
    padding: 88px var(--gutter) 96px;
    text-align: center;
  }

  .hero-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .hero-photo {
    width: 112px;
    height: 112px;
    margin: 0 auto 28px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 18%;
  }

  .hero-eyebrow {
    font-size: clamp(17px, 1.8vw, 21px);
    font-weight: 600;
    color: var(--text-tertiary);
    letter-spacing: -0.015em;
    margin-bottom: 12px;
  }

  .hero-title {
    font-size: clamp(48px, 9vw, 96px);
    line-height: 1.02;
    font-weight: 700;
    letter-spacing: -0.045em;
    color: var(--text);
  }

  .br-sm {
    display: none;
  }

  .hero-lede {
    max-width: 640px;
    margin: 24px auto 0;
    font-size: clamp(19px, 2vw, 24px);
    line-height: 1.38;
    letter-spacing: -0.02em;
    color: var(--text-secondary);
  }

  .hero-actions {
    margin-top: 36px;
    display: flex;
    gap: 28px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .hero-stats {
    max-width: var(--max-w);
    margin: 96px auto 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--hairline);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    padding: 32px 20px 0;
    text-align: left;
  }

  .stat + .stat {
    border-left: 1px solid var(--hairline);
  }

  .stat-value {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--text);
  }

  .stat-label {
    font-size: 14px;
    line-height: 1.35;
    color: var(--text-tertiary);
    letter-spacing: -0.01em;
  }

  @media (max-width: 834px) {
    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
      margin-top: 64px;
    }

    .stat {
      padding: 24px 16px;
    }

    .stat:nth-child(3) {
      border-left: none;
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--hairline);
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding-top: 56px;
      padding-bottom: 64px;
    }

    .br-sm {
      display: inline;
    }
  }
</style>
