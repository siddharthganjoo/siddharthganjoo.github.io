---
import { siteConfig } from '../data/site';
---

<section id="hero" class="hero">
  <div class="hero-container">
    <div class="hero-profile">
      <img 
        src="assets/pp.JPG" 
        alt={`Portrait of ${siteConfig.name}, Machine Learning Engineer`} 
        class="profile-image" 
        width="112" 
        height="112" 
        loading="eager" 
        fetchpriority="high" 
        decoding="async" 
      />
    </div>
    
    <div class="hero-badge">
      <span class="status-dot"></span>
      <span>Machine Learning Engineer // Supercomputing Brabant (TU/e)</span>
    </div>
    
    <h1 class="hero-title">
      Hi, I'm <span class="gradient-text">{siteConfig.name}</span>
    </h1>
    <p class="hero-subtitle">{siteConfig.role}</p>

    <p class="hero-description">
      Scaling distributed AI and high-performance deep learning on the <strong>Spike-A supercomputer</strong> at <strong>Supercomputing Brabant</strong> (TU Eindhoven). 
      Specializing in GPU cluster optimization, distributed training pipelines (PyTorch, SLURM, CUDA), and production computer vision.
    </p>
    
    <div class="hero-actions">
      <a href="#experience" class="btn btn-primary">
        <i class="fas fa-arrow-down"></i> View Experience &amp; Work
      </a>
      <a href="#contact" class="btn btn-secondary">
        <i class="fas fa-paper-plane"></i> Get in Touch
      </a>
      <a href={siteConfig.resumeUrl} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
        <i class="fas fa-file-pdf"></i> Resume
      </a>
    </div>

    <!-- Clean Quick Social Row -->
    <div class="hero-social-links">
      <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer" class="hero-social-link" aria-label="GitHub">
        <i class="fab fa-github"></i> <span>GitHub</span>
      </a>
      <span class="social-sep">•</span>
      <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer" class="hero-social-link" aria-label="LinkedIn">
        <i class="fab fa-linkedin"></i> <span>LinkedIn</span>
      </a>
      <span class="social-sep">•</span>
      <span class="hero-location-tag">
        <i class="fas fa-location-dot"></i> {siteConfig.location}
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5.5rem 1.25rem 3rem;
    text-align: center;
    position: relative;
  }

  .hero-container {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-profile {
    margin-bottom: 1.25rem;
  }

  .profile-image {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 20%;
    border: 3px solid var(--accent);
    box-shadow: 0 8px 30px var(--shadow-glow);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .profile-image:hover {
    transform: scale(1.04);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.9rem;
    border-radius: 50px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 1.25rem;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 2px 10px var(--shadow);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 8px #10b981;
    animation: pulse-dot 2s infinite;
  }

  @keyframes pulse-dot {
    0% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
    100% { opacity: 1; transform: scale(1); }
  }

  .hero-title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 0.35rem;
    color: var(--text);
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    color: var(--text-secondary);
    font-weight: 500;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .hero-description {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 680px;
    margin-bottom: 1.75rem;
  }

  .hero-description strong {
    color: var(--text);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .hero-social-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .hero-social-link {
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.2s ease;
  }

  .hero-social-link:hover {
    color: var(--accent);
  }

  .social-sep {
    color: var(--border);
  }

  .hero-location-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 4.5rem 1rem 2rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
    }

    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
