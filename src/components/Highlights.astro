---
import { timelineData } from '../data/timeline';

const highlights = timelineData.filter(item => item.category === 'news');
---

<section id="highlights" class="section">
  <div class="container">
    <div class="section-head highlights-head reveal">
      <div>
        <span class="eyebrow">Highlights</span>
        <h2 class="headline">Awards, events and press.</h2>
      </div>
      <div class="gallery-controls">
        <button type="button" class="gallery-btn" data-gallery-dir="-1" aria-label="Previous highlights" aria-controls="highlights-track">
          <i class="fas fa-chevron-left" aria-hidden="true"></i>
        </button>
        <button type="button" class="gallery-btn" data-gallery-dir="1" aria-label="Next highlights" aria-controls="highlights-track">
          <i class="fas fa-chevron-right" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>

  <ul class="gallery" id="highlights-track" tabindex="0" aria-label="Highlights">
    {highlights.map(item => (
      <li class="slide card">
        {item.mediaImg ? (
          <button
            type="button"
            class="slide-media"
            data-lightbox-src={item.mediaImg}
            data-lightbox-caption={item.roleTitle}
            aria-label={`Enlarge photo: ${item.mediaAlt || item.roleTitle}`}
          >
            <img src={item.mediaImg} alt={item.mediaAlt || item.roleTitle} loading="lazy" width="800" height="600" />
          </button>
        ) : (
          <div class="slide-media slide-art" aria-hidden="true">
            <i class={`fas ${item.icon || 'fa-star'}`}></i>
          </div>
        )}
        <div class="slide-body">
          <p class="slide-meta">
            <span class:list={['slide-type', { award: item.isAward }]}>{item.typeBadge}</span>
            <span>{item.dateBadge}</span>
          </p>
          <h3 class="slide-title">{item.roleTitle}</h3>
          <p class="slide-org">{item.orgName}</p>
          <p class="slide-desc">{item.description}</p>
          {item.url && (
            <a href={item.url} class="link-chevron slide-link" target="_blank" rel="noopener noreferrer">Learn more</a>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .highlights-head {
    max-width: none;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }

  .gallery-controls {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }

  .gallery-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: var(--fill);
    color: var(--text);
    cursor: pointer;
    font-size: 14px;
    transition: background-color 0.2s var(--ease), opacity 0.2s var(--ease);
  }

  .gallery-btn:hover {
    background: var(--fill-strong);
  }

  .gallery-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* Full-bleed scroller whose first card lines up with the page container */
  .gallery {
    --inset: max(var(--gutter), calc((100vw - var(--max-w)) / 2));
    list-style: none;
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--inset);
    padding: 4px var(--inset) 24px;
    scrollbar-width: none;
  }

  .gallery::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 min(400px, 84vw);
    scroll-snap-align: start;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .slide-media {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: none;
    padding: 0;
    background: var(--fill);
    cursor: zoom-in;
    overflow: hidden;
    border-radius: 0;
  }

  .slide-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .slide-media:hover img {
    transform: scale(1.03);
  }

  .slide-art {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: default;
    background: linear-gradient(160deg, #1d1d1f 0%, #3a3a3c 100%);
    color: #f5f5f7;
    font-size: 56px;
  }

  .slide-link {
    margin-top: 16px;
    font-size: 15px;
  }

  .slide-body {
    padding: 24px 28px 32px;
  }

  .slide-meta {
    display: flex;
    gap: 10px;
    font-size: 14px;
    color: var(--text-tertiary);
    margin-bottom: 8px;
  }

  .slide-type {
    font-weight: 600;
    color: var(--text-secondary);
  }

  .slide-type.award {
    color: #b25000;
  }

  :global([data-theme="dark"]) .slide-type.award {
    color: #ffb340;
  }

  .slide-title {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .slide-org {
    font-size: 15px;
    color: var(--text-secondary);
    margin-top: 2px;
  }

  .slide-desc {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  @media (max-width: 734px) {
    .gallery-controls {
      display: none;
    }

    .gallery {
      gap: 12px;
    }
  }
</style>

<script>
  const track = document.getElementById('highlights-track');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-gallery-dir]');

  function updateButtons() {
    if (!track) return;
    const max = track.scrollWidth - track.clientWidth - 2;
    buttons.forEach(btn => {
      const dir = Number(btn.dataset.galleryDir);
      btn.disabled = dir < 0 ? track.scrollLeft <= 2 : track.scrollLeft >= max;
    });
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      if (!track) return;
      const slide = track.querySelector<HTMLElement>('.slide');
      const step = slide ? slide.offsetWidth + 20 : track.clientWidth * 0.8;
      track.scrollBy({ left: step * Number(btn.dataset.galleryDir), behavior: 'smooth' });
    });
  });

  track?.addEventListener('scroll', updateButtons, { passive: true });
  window.addEventListener('resize', updateButtons);
  updateButtons();
</script>
