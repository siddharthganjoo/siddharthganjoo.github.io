---
import { siteConfig } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <p class="footer-name">{siteConfig.name}</p>
    <p>{siteConfig.role} · {siteConfig.location}</p>
    <div class="footer-bottom">
      <p>© {year} {siteConfig.name}</p>
      <nav class="footer-links" aria-label="Elsewhere">
        <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={siteConfig.socials.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={siteConfig.resumeUrl} target="_blank" rel="noopener noreferrer">Resume</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-alt);
    border-top: 1px solid var(--hairline);
    padding: 32px var(--gutter) 40px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-tertiary);
  }

  .footer-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .footer-name {
    font-weight: 600;
    color: var(--text-secondary);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--hairline);
  }

  .footer-links {
    display: flex;
    gap: 20px;
  }

  .footer-links a {
    color: var(--text-secondary);
    padding: 4px 0;
  }
</style>
