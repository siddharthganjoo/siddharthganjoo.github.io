---
---

<section id="about" class="section about-section">
  <div class="section-container">
    <div class="section-header">
      <span class="section-eyebrow"><i class="fas fa-user"></i> Background</span>
      <h2 class="section-title">About &amp; Focus</h2>
      <p class="section-description">High-performance computing research and applied AI engineering</p>
    </div>
    
    <div class="about-grid">
      <!-- Bio & Education Column -->
      <div class="about-column">
        <div class="bio-card glass-card">
          <h3 class="card-heading"><i class="fas fa-compass text-sky-500"></i> Engineering Focus</h3>
          <p>
            I am a <strong>Machine Learning Engineer</strong> and <strong>Data Scientist</strong> with an MSc in Computer Science &amp; Engineering from 
            <strong>Eindhoven University of Technology (TU/e)</strong>. I specialize in distributed deep learning, high-performance computing on GPU clusters, and production computer vision.
          </p>
          <p>
            At <strong>Supercomputing Brabant</strong> (TU Eindhoven), I work with research teams, startups, and high-tech partners to optimize and scale AI workloads on the 
            <strong>Spike-A supercomputer</strong>. We lower the barrier to advanced supercomputing by migrating cloud bottlenecks to sovereign, distributed European compute.
          </p>
          <p>
            Previously, I served as Co-Founder &amp; CTO at <strong>Loopit.ai</strong> (directing computer vision models for vehicle inspection, earning the €1,000 EAISI AI Incentive Award), 
            and engineered telemetry analytics pipelines at <strong>Vencomatic Group</strong>.
          </p>
        </div>

        <!-- Academic Credentials -->
        <div class="education-card glass-card mt-3">
          <h3 class="card-heading"><i class="fas fa-graduation-cap text-sky-500"></i> Education</h3>
          <div class="education-items">
            <div class="edu-item">
              <img src="assets/logos/tue.png" alt="TU Eindhoven Logo" class="edu-logo" width="40" height="40" loading="lazy" decoding="async" />
              <div>
                <h4>MSc Computer Science &amp; Engineering</h4>
                <p>Eindhoven University of Technology (TU/e) • 2023 – 2025</p>
                <span class="edu-thesis">Thesis: Reinforcement Learning for Adaptive Sorting (Vencomatic Group)</span>
              </div>
            </div>
            <div class="edu-item">
              <img src="assets/logos/jmi.png" alt="Jamia Millia Islamia Logo" class="edu-logo" width="40" height="40" loading="lazy" decoding="async" />
              <div>
                <h4>BTech Computer Engineering</h4>
                <p>Jamia Millia Islamia University • 2019 – 2023</p>
                <span class="edu-thesis">Grade: 8.54/10 • New Delhi, India</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Supercomputing Brabant Spotlight Column -->
      <div class="about-column">
        <div class="spotlight-card glass-card">
          <div class="spotlight-badge-row">
            <span class="spotlight-badge"><i class="fas fa-server"></i> Current Initiative</span>
            <span class="spotlight-sub">TU Eindhoven</span>
          </div>
          <h3 class="spotlight-title">Supercomputing Brabant // Meet the Team</h3>
          
          <div class="timeline-media spotlight-media-wrap" title="Click to enlarge photo">
            <img 
              src="assets/news/supercomputing-brabant-team.jpg" 
              alt="Meet the Team: Supercomputing Brabant at TU Eindhoven launch event" 
              class="spotlight-img"
              loading="lazy" 
              decoding="async" 
              width="600" 
              height="380" 
            />
            <span class="media-zoom-pill"><i class="fas fa-magnifying-glass-plus"></i> View Full Photo</span>
          </div>

          <p class="spotlight-caption">
            With colleagues representing <strong>Supercomputing Brabant</strong> at our regional ecosystem launch event at TU Eindhoven. 
            We support researchers, deep-tech startups, and industry across North Brabant in scaling AI workloads on the <strong>Spike-A supercomputer</strong>.
          </p>
        </div>
      </div>
    </div>

    <!-- Grouped Technical Competencies (Clean 3-Column Strip) -->
    <div class="skills-strip glass-card mt-4">
      <h3 class="skills-strip-title"><i class="fas fa-layer-group text-sky-500"></i> Technical Expertise</h3>
      <div class="skills-columns">
        <div class="skill-group">
          <h4>High-Performance AI &amp; HPC</h4>
          <div class="skill-tags">
            <span>Spike-A Cluster</span>
            <span>Distributed PyTorch</span>
            <span>CUDA</span>
            <span>SLURM</span>
            <span>Multi-GPU Scaling</span>
            <span>HPC Architecture</span>
          </div>
        </div>

        <div class="skill-group">
          <h4>Machine Learning &amp; Vision</h4>
          <div class="skill-tags">
            <span>PyTorch</span>
            <span>YOLOv8</span>
            <span>Reinforcement Learning</span>
            <span>OpenCV</span>
            <span>CodeT5</span>
            <span>Scikit-learn</span>
          </div>
        </div>

        <div class="skill-group">
          <h4>Data &amp; Cloud Infrastructure</h4>
          <div class="skill-tags">
            <span>Python</span>
            <span>SQL Server</span>
            <span>Streamlit</span>
            <span>Azure</span>
            <span>Docker</span>
            <span>Linux</span>
            <span>Git / CI/CD</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1.5rem;
    align-items: start;
  }

  .about-column {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .bio-card, .education-card, .spotlight-card {
    padding: 1.5rem 1.6rem;
    border-radius: 14px;
  }

  .card-heading {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
  }

  .bio-card p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .bio-card p:last-of-type {
    margin-bottom: 0;
  }

  .bio-card strong {
    color: var(--text);
  }

  /* Education */
  .education-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .edu-item {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .edu-logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: 6px;
    background: var(--bg);
    padding: 3px;
    border: 1px solid var(--border);
    flex-shrink: 0;
  }

  .edu-item h4 {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.15rem;
  }

  .edu-item p {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 0.15rem;
  }

  .edu-thesis {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-style: italic;
  }

  /* Spotlight Card */
  .spotlight-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .spotlight-badge {
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #8b5cf6;
    background: rgba(139, 92, 246, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.25);
    padding: 0.2rem 0.55rem;
    border-radius: 50px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .spotlight-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .spotlight-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.85rem;
  }

  .spotlight-media-wrap {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    border: 1px solid var(--border);
    background: var(--bg);
    margin-bottom: 0.85rem;
  }

  .spotlight-img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    transition: transform 0.35s ease;
  }

  .spotlight-media-wrap:hover .spotlight-img {
    transform: scale(1.03);
  }

  .spotlight-caption {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .spotlight-caption strong {
    color: var(--text);
  }

  /* Skills Strip */
  .skills-strip {
    padding: 1.5rem 1.6rem;
    border-radius: 14px;
  }

  .skills-strip-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 1.15rem;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .skills-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .skill-group h4 {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-bottom: 0.65rem;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skill-tags span {
    font-size: 0.775rem;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .skills-columns {
      grid-template-columns: 1fr;
      gap: 1.15rem;
    }
  }
</style>
